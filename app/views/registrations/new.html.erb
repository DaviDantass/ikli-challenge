<main class="page">
  <section class="card">
    <h1>Criar conta</h1>

      <% if @user.errors.any? %>
        <p class="message error">
          <%= @user.errors.full_messages.to_sentence %>
        </p>
      <% end %>

    <%= form_with model: @user, url: registration_path, class: "upload-form" do |form| %>
        <%= form.label :name, "Nome" %>
        <%= form.text_field :name, required: true %>

        <%= form.label :email, "E-mail" %>
        <%= form.email_field :email, required: true, autocomplete: "email" %>

        <%= form.label :password, "Senha" %>
        <%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password" %>

        <%= form.label :password_confirmation, "Confirme a senha" %>
        <%= form.password_field :password_confirmation, required: true, minlength: 8, autocomplete: "new-password" %>

        <%= form.submit "Criar conta" %>
    <% end %>

    <%= link_to "Já tenho uma conta", new_session_path, class: "auth-link" %>
  </section>
</main>
